{
  "name": "lens_inspect",
  "owner": "pc-lens",
  "seed": 12345,
  "steps": [
    {"op": "note", "text": "pc-lens (the Lens spec, section 2): inspect mode on the Lens case screen, day 12, the traveller's paper on the left and the Registry entry of its number (typed: DP-5601, seed 12345) on the right. Inspect off: a click on a field picks nothing and the notice says Press Space to inspect. Space: inspect on. A field on each side: the answer plate says Matching data or Discrepancy; then two fields of another kind: No relation. Esc clears the pick, Esc again ends inspect, a right-click takes one step back. The Registry: a number with no record, the No entry line and the ID of a paper give one finding (Discrepancy). At 1920x1080."},
    {"op": "title"},
    {"op": "res", "w": 1920, "h": 1080},
    {"op": "newRun", "text": "Biscuit"},
    {"op": "waitOffice", "n": 1},
    {"op": "cheat", "name": "GiveAllItems"},
    {"op": "cheat", "name": "UnlockEverything", "n": 1},
    {"op": "jumpDay", "n": 12},
    {"op": "waitOffice", "n": 12},
    {"op": "startShift"},
    {"op": "sign"},
    {"op": "waitTraveller", "f": 90},
    {"op": "wait", "f": 2},
    {"op": "key", "key": "Q"},
    {"op": "wait", "f": 1.5},
    {"op": "click", "target": "StartButton"},
    {"op": "wait", "f": 0.5},
    {"op": "click", "target": "App_investigation"},
    {"op": "wait", "f": 1.0},
    {"op": "lensScan", "n": 1},
    {"op": "wait", "f": 1.0},
    {"op": "lensExpect", "name": "paper_scanned", "text": "papers>=1 left=Documents:0 right=none selected=right"},
    {"op": "lensClick", "name": "registry", "text": "dock:Records"},
    {"op": "lensRegistry", "text": "DP-5601"},
    {"op": "wait", "f": 0.5},
    {"op": "lensExpect", "name": "registry_right", "text": "left=Documents:0 right=Records"},
    {"op": "lensClick", "name": "field_off", "text": "row:left:Full Name"},
    {"op": "lensExpect", "name": "no_pick_when_off", "text": "inspect=off pick=none line=no plate=none notice=hint"},
    {"op": "still", "name": "lens_inspect_notice"},
    {"op": "key", "key": "Space"},
    {"op": "wait", "n": 10},
    {"op": "lensExpect", "name": "inspect_on", "text": "inspect=on pick=none"},
    {"op": "still", "name": "lens_inspect_on"},
    {"op": "lensExpect", "name": "mark", "text": "mark=1"},
    {"op": "lensClick", "name": "left_name", "text": "row:left:Full Name"},
    {"op": "lensExpect", "name": "first_pick", "text": "inspect=on pick=held plate=hold"},
    {"op": "still", "name": "lens_inspect_first_pick"},
    {"op": "lensClick", "name": "right_name", "text": "row:right:Name"},
    {"op": "lensExpect", "name": "answer", "text": "inspect=on plate=match|differ line=yes"},
    {"op": "still", "name": "lens_inspect_answer"},
    {"op": "lensClick", "name": "right_other", "text": "row:right:!Name"},
    {"op": "lensClick", "name": "left_name_again", "text": "row:left:Full Name"},
    {"op": "lensExpect", "name": "no_relation", "text": "plate=info line=yes"},
    {"op": "still", "name": "lens_inspect_no_relation"},
    {"op": "key", "key": "Escape"},
    {"op": "wait", "n": 12},
    {"op": "lensExpect", "name": "esc_clears_pick", "text": "pick=none line=no inspect=on"},
    {"op": "still", "name": "lens_inspect_esc1"},
    {"op": "key", "key": "Escape"},
    {"op": "wait", "n": 12},
    {"op": "lensExpect", "name": "esc_ends_inspect", "text": "inspect=off"},
    {"op": "key", "key": "Space"},
    {"op": "wait", "n": 10},
    {"op": "lensClick", "name": "pick_again", "text": "row:left:Full Name"},
    {"op": "lensExpect", "name": "held_again", "text": "inspect=on pick=held"},
    {"op": "lensRightClick"},
    {"op": "lensExpect", "name": "right_click_one_step", "text": "pick=none inspect=on"},
    {"op": "still", "name": "lens_inspect_right_click"},
    {"op": "lensExpect", "name": "mark2", "text": "mark=1"},
    {"op": "lensRegistry", "text": "ZZ-9999"},
    {"op": "wait", "f": 0.5},
    {"op": "lensClick", "name": "no_entry", "text": "noentry"},
    {"op": "lensExpect", "name": "no_entry_held", "text": "pick=held"},
    {"op": "lensClick", "name": "paper_id", "text": "row:left:~(\bID\b|Displacement No|Number)"},
    {"op": "lensExpect", "name": "no_record_finding", "text": "plate=differ new=1"},
    {"op": "still", "name": "lens_inspect_no_entry"},
    {"op": "key", "key": "Q"},
    {"op": "wait", "f": 0.8},
    {"op": "probe", "name": "end"}
  ]
}
