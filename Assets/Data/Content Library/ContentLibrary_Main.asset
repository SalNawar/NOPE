  personalities:
  - id: chatty
    name: Chatty
    weight: 1
    note: Tells you everything, then a bit more.
    waiverRefusal: 0.05
    confess: 0.6
    strandingFate: News
  - id: curt
    name: Curt
    weight: 1
    note: Time is money, and in 2150 the queue bills by the minute.
    waiverRefusal: 0.3
    confess: 0.3
    strandingFate: 
  - id: anxious
    name: Anxious
    weight: 1
    note: Worried about paradoxes, transponders, butterflies and you.
    waiverRefusal: 0.05
    confess: 0.8
    strandingFate: Forgotten
  - id: sunny
    name: Sunny
    weight: 1
    note: Believes every word the agency prints.
    waiverRefusal: 0.05
    confess: 0.7
    strandingFate: 
  - id: grand
    name: Grand
    weight: 1
    note: Treats the desk as staff, whatever their account says.
    waiverRefusal: 0.5
    confess: 0.15
    strandingFate: Carry
  - id: stickler
    name: Stickler
    weight: 1
    note: Knows the regulations better than the clerk and says so.
    waiverRefusal: 0.1
    confess: 0.5
    strandingFate: 
  - id: glum
    name: Glum
    weight: 1
    note: The debt won years ago; this is just the paperwork.
    waiverRefusal: 0.05
    confess: 0.4
    strandingFate: Forgotten
