    sites:
    - id: news
      kind: 0
      name: The Temporal Times
      domain: times.tc
      glyph: site_news
      blurb: Today's edition and back issues.
      fromDay: 1
    - id: history
      kind: 1
      name: Chronopedia
      domain: chronopedia
      glyph: site_history
      blurb: Every place and era, as history stands today.
      fromDay: 1
    - id: ancestry
      kind: 2
      name: Lineage Archive
      domain: lineage
      glyph: site_ancestry
      blurb: Citizens of the past.
      fromDay: 1
    pages: []
    ancestry:
      includePremades: 1
      people:
      - id: ramose
        name: Ramose
        born: 
        died: 
        place: egypt_ancient
        note: Father of Senenmut. A man of modest rank from Armant.
      - id: hatshepsut
        name: Hatshepsut
        born: c. 1507 BCE
        died: 1458 BCE
        place: egypt_ancient
        note: Pharaoh of Egypt. Senenmut stewarded her household and built her temple.
      - id: senenmut
        name: Senenmut
        born: c. 1505 BCE
        died: 
        place: egypt_ancient
        note: Steward of Hatshepsut's household and architect of her temple at Deir
          el-Bahari.
      - id: neferure
        name: Neferure
        born: c. 1505 BCE
        died: 
        place: egypt_ancient
        note: Daughter of Pharaoh Hatshepsut. Senenmut was her tutor.
      - id: pericles
        name: Pericles
        born: c. 495 BCE
        died: 429 BCE
        place: greece_ancient
        note: Strategos of Athens. Companion of Aspasia.
      - id: pericles_younger
        name: Pericles the Younger
        born: c. 440 BCE
        died: 406 BCE
        place: greece_ancient
        note: Son of Pericles and Aspasia. A general of Athens.
      - id: aspasia
        name: Aspasia
        born: c. 470 BCE
        died: c. 400 BCE
        place: greece_ancient
        note: Teacher of rhetoric in Athens. Companion of Pericles.
      - id: banbiao
        name: Ban Biao
        born: 3
        died: 54
        place: china_ancient
        note: Historian. Father of Ban Gu, Ban Chao and Ban Zhao.
      - id: bangu
        name: Ban Gu
        born: 32
        died: 92
        place: china_ancient
        note: Historian of the Han. Began the Book of Han, which his sister finished.
      - id: banchao
        name: Ban Chao
        born: 32
        died: 102
        place: china_ancient
        note: General who held the Western Regions for the Han.
      - id: banzhao
        name: Ban Zhao
        born: 45
        died: 117
        place: china_ancient
        note: Court historian and tutor to the empress. Finished her brother's Book
          of Han.
      - id: mamun
        name: Caliph al-Ma'mun
        born: 786
        died: 833
        place: iraq_medieval
        note: Caliph in Baghdad. Patron of the House of Wisdom.
      - id: arib
        name: Arib al-Ma'muniyya
        born: 797
        died: 890
        place: iraq_medieval
        note: Singer and poet of the caliph's court. Travelled with her own musicians.
      - id: fust
        name: Johann Fust
        born: c. 1400
        died: 1466
        place: germany_medieval
        note: Goldsmith and lender of Mainz. Financed Gutenberg's press.
      - id: schoeffer
        name: Peter Schoeffer
        born: c. 1425
        died: c. 1503
        place: germany_medieval
        note: Scribe and printer. Worked Gutenberg's press, then Fust's.
      - id: piero
        name: Ser Piero da Vinci
        born: 1426
        died: 1504
        place: italy_medieval
        note: Notary of Florence. Father of Leonardo.
      - id: verrocchio
        name: Andrea del Verrocchio
        born: c. 1435
        died: 1488
        place: italy_medieval
        note: Sculptor and painter of Florence. Leonardo trained in his workshop.
      - id: ludovico
        name: Ludovico Sforza
        born: 1452
        died: 1508
        place: italy_earlymodern
        note: Duke of Milan. Patron of Leonardo.
      - id: gallerani
        name: Cecilia Gallerani
        born: 1473
        died: 1536
        place: italy_earlymodern
        note: Lady of the Milanese court. Sat for Leonardo's portrait with an ermine.
      - id: bassano
        name: Baptiste Bassano
        born: 
        died: 1576
        place: britain_earlymodern
        note: Venetian-born court musician to the Tudors. Father of Aemilia Lanyer.
      - id: lanyer
        name: Aemilia Lanyer
        born: 1569
        died: 1645
        place: britain_earlymodern
        note: Poet of London, raised in a countess's household.
      relations:
      - person: senenmut
        kind: Father
        other: ramose
      - person: senenmut
        kind: Pharaoh
        other: hatshepsut
      - person: senenmut
        kind: Pupil
        other: neferure
      - person: ramose
        kind: Son
        other: senenmut
      - person: hatshepsut
        kind: Daughter
        other: neferure
      - person: hatshepsut
        kind: Steward
        other: senenmut
      - person: neferure
        kind: Mother
        other: hatshepsut
      - person: neferure
        kind: Tutor
        other: senenmut
