    strandChance: 0.08
    strandingFates:
    - id: forgotten
      fate: 0
      weightWaivered: 40
      weightUnwaivered: 20
      stability: 0
      status: 'Status: not recovered. No trace in the record.'
      lines: []
    - id: news
      fate: 1
      weightWaivered: 25
      weightUnwaivered: 20
      stability: 0
      status: 'Status: not recovered. Traces in the record are under review.'
      lines:
      - era: 
        text: Chroniclers in {place} record a stranger called {name} who predicted
          the weather, the harvest and the queue.
      - era: 
        text: '{place}: a traveller named {name} sells horoscopes that are, unhelpfully,
          all correct.'
      - era: ancient
        text: Scribes in {place} record a stranger who spoke to their wrist and was
          answered.
      - era: ancient
        text: An oracle near {place} starts answering in credit ratings. The pilgrims
          pay anyway.
      - era: medieval
        text: Monks in {place} copy out a sermon by one {name} against compound interest.
      - era: earlymodern
        text: A pamphlet from {place}, signed {name}, explains the queue in forty
          pages. Nobody understands it.
      - era: industrial
        text: The papers in {place} laugh at {name}, who says one day every letter
          will arrive at once.
      - era: modern
        text: A caller to a radio show in {place}, calling in as {name}, reads out
          tomorrow's results. The line goes dead.
    - id: carry
      fate: 2
      weightWaivered: 20
      weightUnwaivered: 20
      stability: 0
      status: 'Status: not recovered. 2150 technology reported at the destination.'
      lines: []
    - id: tremor
      fate: 3
      weightWaivered: 10
      weightUnwaivered: 15
      stability: 1
      status: 'Status: not recovered. Timeline Integrity notified of a tremor.'
      lines:
      - era: 
        text: TIMELINE TREMOR near {place}. The Directorate says it is nothing.
      - era: 
        text: Clocks near {place} ran eleven minutes backward last night. The Directorate
          calls this normal.
    - id: police
      fate: 4
      weightWaivered: 5
      weightUnwaivered: 25
      stability: 0
      status: 'Status: removed by the Time Police. File closed.'
      lines:
      - era: 
        text: 'TIME POLICE: an unregistered traveller was removed from {place}. The
          file is closed.'
      - era: 
        text: TIME POLICE report one removal in {place}. No further action. No further
          traveller.
      - era: 
        text: 'TIME POLICE: a stranded traveller in {place} was located and retired.
          The paperwork is complete.'
    strandingReport:
      unit: Unit {unit} failed in {place}.
      traveller: 'Traveller: {name}, Citizen ID {id}.'
      waivered: 'Waiver {waiver} on file: the traveller''s debt of {debt} passes
        to kin.'
      unwaivered: No valid signed waiver on file. Liability referred to Desk 3.
      fine: A stranding fine of {fine} has been charged to Desk 3.
