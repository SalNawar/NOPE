  interview:
    deskName: DESK
    opener:
      id: interview.opener
      text: Next! Step forward, {honorific}.
    openerLegendary:
      id: interview.openerLegendary
      text: 'Priority arrival: {name}.'
    openerReturning:
      id: interview.openerReturning
      text: Back again, {honorific}? You stood at this window on day {day}.
    claims:
    - kind: 0
      line:
        id: interview.claims.RichTourist
        text: One leisure departure to {place}, please.
    - kind: 1
      line:
        id: interview.claims.PoorTourist
        text: One leisure departure to {place}, please.
    - kind: 2
      line:
        id: interview.claims.Labourer
        text: One Debt Relief departure to {place}. I have a contract to work.
    - kind: 3
      line:
        id: interview.claims.Displaced
        text: Please. Send me home to {place}.
    honorificMale: sir
    honorificFemale: madam
    honorificUnknown: traveller
    requestLabel: Hand me your {document}
    papersLabel: Ask for papers >
    askGroups: []
    missingFormReplies:
    - kind: 0
      request: TC-310
      variant: 0
      line:
        id: interview.missingFormReplies.RichTourist.TC-310.Honest
        text: It's a Premium unit, I don't need one.
    - kind: 1
      request: TC-310
      variant: 1
      line:
        id: interview.missingFormReplies.PoorTourist.TC-310.Missing
        text: I... didn't get round to that one.
    - kind: 2
      request: TC-310
      variant: 1
      line:
        id: interview.missingFormReplies.Labourer.TC-310.Missing
        text: I... didn't get round to that one.
    - kind: 3
      request: TC-230
      variant: 0
      line:
        id: interview.missingFormReplies.Displaced.TC-230.Honest
        text: A ticket? I was pulled out of my own time. I didn't pack.
    - kind: 3
      request: TC-310
      variant: 0
      line:
        id: interview.missingFormReplies.Displaced.TC-310.Honest
        text: A waiver? Nobody asked me anything before the sky opened.
    - kind: 0
      request: TC-620
      variant: 0
      line:
        id: interview.missingFormReplies.RichTourist.TC-620.Honest
        text: An intake declaration? I'm leaving, not arriving.
    - kind: 0
      request: TC-630
      variant: 0
      line:
        id: interview.missingFormReplies.RichTourist.TC-630.Honest
        text: A return order? I have a return booking. Is that the same thing?
    - kind: 1
      request: TC-620
      variant: 0
      line:
        id: interview.missingFormReplies.PoorTourist.TC-620.Honest
        text: An intake declaration? I'm leaving, not arriving.
    - kind: 1
      request: TC-630
      variant: 0
      line:
        id: interview.missingFormReplies.PoorTourist.TC-630.Honest
        text: A return order? I have a return booking. Is that the same thing?
    - kind: 2
      request: TC-620
      variant: 0
      line:
        id: interview.missingFormReplies.Labourer.TC-620.Honest
        text: An intake declaration? I'm leaving, not arriving.
    - kind: 2
      request: TC-630
      variant: 0
      line:
        id: interview.missingFormReplies.Labourer.TC-630.Honest
        text: A return order? I have a return booking. Is that the same thing?
    requestPrompt:
      id: interview.requestPrompt
      text: Your {document}, please.
    requestReply:
      id: interview.requestReply
      text: Here you are.
    askLabel: Ask >
    backLabel: < Back
    smallTalkLabel: Small talk
    lookLabel: Look >
    faceLabel: Their face
    smallTalkPrompt:
      id: interview.smallTalkPrompt
      text: How is life back home?
    requests:
    - id: step_closer
      label: Step closer
      prompt:
        id: interview.requests.step_closer.prompt
        text: Step closer to the glass, please.
      reply:
        id: interview.requests.step_closer.reply
        text: Like this?
    - id: speak_up
      label: Speak up
      prompt:
        id: interview.requests.speak_up.prompt
        text: Speak up, please. I can barely hear you.
      reply:
        id: interview.requests.speak_up.reply
        text: Sorry. Is this better?
    menuCapacity: 9
    smallTalkWeights:
      personality: 1
      home: 1
      kind: 1
    kindSmallTalk:
    - personality: 
      premade: 
      kinds: 00000000
      era: 
      key: 
      variant: 0
      verdict: 0
      intent: 0
      reason: 
      lie: 
      outcome: 0
      line:
        id: interview.kindSmallTalk.1
        text: We do three eras a year. The children prefer the ones with castles.
      then:
        id: 
        text: 
    - personality: 
      premade: 
      kinds: 01000000
      era: 
      key: 
      variant: 0
      verdict: 0
      intent: 0
      reason: 
      lie: 
      outcome: 0
      line:
        id: interview.kindSmallTalk.2
        text: Two years of saving, and the credit company paid the rest. So kind
          of them.
      then:
        id: 
        text: 
    - personality: 
      premade: 
      kinds: 02000000
      era: 
      key: 
      variant: 0
      verdict: 0
      intent: 0
      reason: 
      lie: 
      outcome: 0
      line:
        id: interview.kindSmallTalk.3
        text: They say the past has fresh air. And fourteen-hour shifts.
      then:
        id: 
        text: 
    - personality: 
      premade: 
      kinds: 03000000
      era: 
      key: 
      variant: 0
      verdict: 0
      intent: 0
      reason: 
      lie: 
      outcome: 0
      line:
