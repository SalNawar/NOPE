  historyLines:
    leaderGained:
      id: history.leaderGained
      text: 'HISTORY: {nation} now dominates the timeline. The Future belongs to
        {place}.'
    leaderLost:
      id: history.leaderLost
      text: 'HISTORY: {nation} no longer dominates the timeline. The Future is unsettled
        until a new power rises.'
    carry:
      id: history.carry
      text: 'HISTORY: travellers brought {value} to {place}.'
    dominant:
      id: history.dominant
      text: '{attribute} is now DOMINANT in {place}.'
    panic:
      id: history.panic
      text: 'PANIC in {place}: a traveller from the agency was seen in "{value}"
        and the street fled.'
  pc:
    sites:
    - id: news
      kind: 0
      name: The Temporal Times
      domain: times.tc
      glyph: site_news
      blurb: Today's edition and back issues.
      fromDay: 1
    - id: history
      kind: 1
      name: Chronopedia
      domain: chronopedia
      glyph: site_history
      blurb: Every place and era, as history stands today.
      fromDay: 1
    - id: ancestry
      kind: 2
      name: Lineage Archive
      domain: lineage
      glyph: site_ancestry
      blurb: Citizens of the past.
      fromDay: 1
    pages: []
    ancestry:
      includePremades: 1
      people:
      - id: ramose
        name: Ramose
        born: 
        died: 
        place: egypt_ancient
        note: Father of Senenmut. A man of modest rank from Armant.
      - id: hatshepsut
        name: Hatshepsut
        born: c. 1507 BCE
        died: 1458 BCE
        place: egypt_ancient
        note: Pharaoh of Egypt. Senenmut stewarded her household and built her temple.
      - id: neferure
        name: Neferure
        born: c. 1505 BCE
        died: 
        place: egypt_ancient
        note: Daughter of Pharaoh Hatshepsut. Senenmut was her tutor.
      - id: pericles
        name: Pericles
        born: c. 495 BCE
        died: 429 BCE
        place: greece_ancient
        note: Strategos of Athens. Companion of Aspasia.
      - id: pericles_younger
        name: Pericles the Younger
        born: c. 440 BCE
        died: 406 BCE
        place: greece_ancient
        note: Son of Pericles and Aspasia. A general of Athens.
      - id: banbiao
        name: Ban Biao
        born: 3
        died: 54
        place: china_ancient
        note: Historian. Father of Ban Gu, Ban Chao and Ban Zhao.
      - id: bangu
        name: Ban Gu
        born: 32
        died: 92
        place: china_ancient
        note: Historian of the Han. Began the Book of Han, which his sister finished.
      - id: banchao
        name: Ban Chao
        born: 32
        died: 102
        place: china_ancient
        note: General who held the Western Regions for the Han.
      - id: mamun
        name: Caliph al-Ma'mun
        born: 786
        died: 833
        place: iraq_medieval
        note: Caliph in Baghdad. Patron of the House of Wisdom.
      - id: fust
        name: Johann Fust
        born: c. 1400
        died: 1466
        place: germany_medieval
        note: Goldsmith and lender of Mainz. Financed Gutenberg's press.
      - id: schoeffer
        name: Peter Schoeffer
        born: c. 1425
        died: c. 1503
        place: germany_medieval
        note: Scribe and printer. Worked Gutenberg's press, then Fust's.
      - id: piero
        name: Ser Piero da Vinci
        born: 1426
        died: 1504
        place: italy_medieval
        note: Notary of Florence. Father of Leonardo.
      - id: verrocchio
        name: Andrea del Verrocchio
        born: c. 1435
        died: 1488
        place: italy_medieval
        note: Sculptor and painter of Florence. Leonardo trained in his workshop.
      - id: ludovico
        name: Ludovico Sforza
        born: 1452
        died: 1508
        place: italy_earlymodern
        note: Duke of Milan. Patron of Leonardo.
      - id: bassano
        name: Baptiste Bassano
        born: 
        died: 1576
        place: britain_earlymodern
        note: Venetian-born court musician to the Tudors. Father of Aemilia Lanyer.
      relations:
      - person: senenmut
        kind: Father
        other: ramose
      - person: senenmut
        kind: Pharaoh
        other: hatshepsut
      - person: senenmut
        kind: Pupil
        other: neferure
      - person: ramose
