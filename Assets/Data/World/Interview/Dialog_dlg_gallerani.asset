  m_Script: {fileID: 11500000, guid: 216f58e381e1445588efbd033278b8d9, type: 3}
  m_Name: Dialog_dlg_gallerani
  m_EditorClassIdentifier: Assembly-CSharp::DialogSO
  dialog:
    id: dlg_gallerani
    label: Ask about their work >
    oneShot: 1
    nodes:
    - id: start
      lines:
      - id: dlg_gallerani.start.1
        speaker: 1
        text: Leonardo painted me with an ermine. He said I turned my head the right
          way.
        expression: neutral
      choices:
      - id: more1
        label: Go on.
        lines: []
        next: line2
        effect: 
      - id: bye1
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: line2
      lines:
      - id: dlg_gallerani.line2.1
        speaker: 1
        text: My salon has poets on Mondays and philosophers on Thursdays. The ermine
          prefers poets.
        expression: happy
      choices:
      - id: more2
        label: Go on.
        lines: []
        next: line3
        effect: 
      - id: bye2
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: line3
      lines:
      - id: dlg_gallerani.line3.1
        speaker: 1
        text: Is the ermine allowed? It has no papers. It has never had papers.
        expression: worried
      choices:
      - id: done
        label: Next!
        lines: []
        next: 
        effect: 
  conditions: []
