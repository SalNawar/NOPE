  m_Script: {fileID: 11500000, guid: 216f58e381e1445588efbd033278b8d9, type: 3}
  m_Name: Dialog_dlg_banzhao
  m_EditorClassIdentifier: Assembly-CSharp::DialogSO
  dialog:
    id: dlg_banzhao
    label: Ask about their work >
    oneShot: 1
    nodes:
    - id: start
      lines:
      - id: dlg_banzhao.start.1
        speaker: 1
        text: My brother died before the Book of Han was done. I finished the astronomy
          tables.
        expression: neutral
      choices:
      - id: more1
        label: Go on.
        lines: []
        next: line2
        effect: 
      - id: bye1
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: line2
      lines:
      - id: dlg_banzhao.line2.1
        speaker: 1
        text: The empress herself sits in my lessons. She takes better notes than
          the ministers.
        expression: happy
      choices:
      - id: more2
        label: Go on.
        lines: []
        next: line3
        effect: 
      - id: bye2
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: line3
      lines:
      - id: dlg_banzhao.line3.1
        speaker: 1
        text: If your record has an error, it is copied forever. I check every character
          twice.
        expression: worried
      choices:
      - id: done
        label: Next!
        lines: []
        next: 
        effect: 
  conditions: []
