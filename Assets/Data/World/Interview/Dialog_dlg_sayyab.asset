  dialog:
    id: dlg_sayyab
    label: Ask about their work >
    oneShot: 1
    nodes:
    - id: start
      lines:
      - id: dlg_sayyab.start.1
        speaker: 1
        text: Rain, rain, rain. That is the whole poem. Also the Gulf, and the hunger.
        expression: neutral
      choices:
      - id: more1
        label: Go on.
        lines: []
        next: line2
        effect: 
      - id: bye1
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: line2
      lines:
      - id: dlg_sayyab.line2.1
        speaker: 1
        text: Nazik says she was first with free verse. She was not. Ask anyone in
          Basra.
        expression: happy
      choices:
      - id: more2
        label: Go on.
        lines: []
        next: line3
        effect: 
      - id: bye2
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: line3
      lines:
      - id: dlg_sayyab.line3.1
        speaker: 1
        text: My village has palm trees and a river. Does it still have them in 2150?
        expression: worried
      choices:
      - id: done
        label: Next!
        lines: []
        next: 
        effect: 
