  m_Script: {fileID: 11500000, guid: 216f58e381e1445588efbd033278b8d9, type: 3}
  m_Name: Dialog_dlg_senenmut
  m_EditorClassIdentifier: Assembly-CSharp::DialogSO
  dialog:
    id: dlg_senenmut
    label: Ask about their work >
    oneShot: 1
    nodes:
    - id: start
      lines:
      - id: dlg_senenmut.start.1
        speaker: 1
        text: Your ceiling is three cubits too low. I say this as a friend.
        expression: neutral
      choices:
      - id: more1
        label: Go on.
        lines: []
        next: line2
        effect: 
      - id: bye1
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: line2
      lines:
      - id: dlg_senenmut.line2.1
        speaker: 1
        text: The queen gave me her daughter to teach. And a temple to build. In
          that order.
        expression: happy
      choices:
      - id: more2
        label: Go on.
        lines: []
        next: line3
        effect: 
      - id: bye2
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: line3
      lines:
      - id: dlg_senenmut.line3.1
        speaker: 1
        text: They will chisel her name off the walls one day. I put mine behind
          the doors.
        expression: worried
      choices:
      - id: done
        label: Next!
        lines: []
        next: 
        effect: 
  conditions: []
