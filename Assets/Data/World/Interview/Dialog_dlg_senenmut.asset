  m_Script: {fileID: 11500000, guid: 216f58e381e1445588efbd033278b8d9, type: 3}
  m_Name: Dialog_dlg_senenmut
  m_EditorClassIdentifier: Assembly-CSharp::DialogSO
  dialog:
    id: dlg_senenmut
    label: Ask about the temple >
    oneShot: 1
    nodes:
    - id: start
      lines:
      - id: dlg_senenmut.start.1
        speaker: 1
        text: My temple at Deir el-Bahari rises in three terraces. The Pharaoh will
          be pleased.
        expression: happy
      choices:
      - id: more
        label: And if she is not?
        lines: []
        next: worried
        effect: 
      - id: bye
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: worried
      lines:
      - id: dlg_senenmut.worried.1
        speaker: 1
        text: Then my name will be chiselled off every wall. Let us hope your stamp
          is kind.
        expression: worried
      choices:
      - id: done
        label: Next!
        lines: []
        next: 
        effect: 
  conditions: []
