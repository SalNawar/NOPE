  m_Script: {fileID: 11500000, guid: 216f58e381e1445588efbd033278b8d9, type: 3}
  m_Name: Dialog_dlg_ramesses
  m_EditorClassIdentifier: Assembly-CSharp::DialogSO
  dialog:
    id: dlg_ramesses
    label: Ask about the temples >
    oneShot: 1
    nodes:
    - id: start
      lines:
      - id: dlg_ramesses.start.1
        speaker: 1
        text: My temple at Abu Simbel has four of me out front. Each one larger than
          the last.
        expression: happy
      choices:
      - id: more
        label: And the Hittites?
        lines: []
        next: treaty
        effect: 
      - id: bye
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: treaty
      lines:
      - id: dlg_ramesses.treaty.1
        speaker: 1
        text: We signed the first peace treaty ever written. They still say they
          won Kadesh. They did not.
        expression: worried
      choices:
      - id: done
        label: Next!
        lines: []
        next: 
        effect: 
  conditions: []
