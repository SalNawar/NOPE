  m_Script: {fileID: 11500000, guid: 216f58e381e1445588efbd033278b8d9, type: 3}
  m_Name: Dialog_dlg_arib
  m_EditorClassIdentifier: Assembly-CSharp::DialogSO
  dialog:
    id: dlg_arib
    label: Ask about their work >
    oneShot: 1
    nodes:
    - id: start
      lines:
      - id: dlg_arib.start.1
        speaker: 1
        text: Name any song from Baghdad. I know it, and I know who stole it from
          whom.
        expression: happy
      choices:
      - id: more1
        label: Go on.
        lines: []
        next: line2
        effect: 
      - id: bye1
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: line2
      lines:
      - id: dlg_arib.line2.1
        speaker: 1
        text: Six caliphs have asked me to sing. I have outlived five of them.
        expression: neutral
      choices:
      - id: more2
        label: Go on.
        lines: []
        next: line3
        effect: 
      - id: bye2
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: line3
      lines:
      - id: dlg_arib.line3.1
        speaker: 1
        text: You want me to hum for the stamp? Pay me like a caliph first.
        expression: angry
      choices:
      - id: done
        label: Next!
        lines: []
        next: 
        effect: 
  conditions: []
