  m_Script: {fileID: 11500000, guid: 216f58e381e1445588efbd033278b8d9, type: 3}
  m_Name: Dialog_dlg_gutenberg
  m_EditorClassIdentifier: Assembly-CSharp::DialogSO
  dialog:
    id: dlg_gutenberg
    label: Ask about Strasbourg >
    oneShot: 1
    nodes:
    - id: start
      lines:
      - id: dlg_gutenberg.start.1
        speaker: 1
        text: My business in Strasbourg? Mirrors. Pilgrims buy little mirrors to
          catch the holy light.
        expression: worried
      choices:
      - id: only
        label: Only mirrors?
        lines: []
        next: only
        effect: 
      - id: bye
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: only
      lines:
      - id: dlg_gutenberg.only.1
        speaker: 1
        text: Mirrors. And a small press. A very small press. Please do not write
          that down.
        expression: worried
      choices:
      - id: done
        label: I didn't hear a thing.
        lines: []
        next: 
        effect: 
  conditions: []
