  dialog:
    id: dlg_meitner
    label: Ask about their work >
    oneShot: 1
    nodes:
    - id: start
      lines:
      - id: dlg_meitner.start.1
        speaker: 1
        text: Otto Hahn found the barium. I explained it. The prize went to Otto.
        expression: neutral
      choices:
      - id: more1
        label: Go on.
        lines: []
        next: line2
        effect: 
      - id: bye1
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: line2
      lines:
      - id: dlg_meitner.line2.1
        speaker: 1
        text: I left Berlin with ten marks and a diamond ring. Do you check rings?
        expression: worried
      choices:
      - id: more2
        label: Go on.
        lines: []
        next: line3
        effect: 
      - id: bye2
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: line3
      lines:
      - id: dlg_meitner.line3.1
        speaker: 1
        text: Element one hundred and nine has my name. That is better than a prize.
        expression: happy
      choices:
      - id: done
        label: Next!
        lines: []
        next: 
