  dialog:
    id: dlg_elytis
    label: Ask about their work >
    oneShot: 1
    nodes:
    - id: start
      lines:
      - id: dlg_elytis.start.1
        speaker: 1
        text: Your window has no sea in it. I can lend you one. It is very blue.
        expression: happy
      choices:
      - id: more1
        label: Go on.
        lines: []
        next: line2
        effect: 
      - id: bye1
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: line2
      lines:
      - id: dlg_elytis.line2.1
        speaker: 1
        text: I changed my name so my family soap company would not be embarrassed.
        expression: neutral
      choices:
      - id: more2
        label: Go on.
        lines: []
        next: line3
        effect: 
      - id: bye2
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: line3
      lines:
      - id: dlg_elytis.line3.1
        speaker: 1
        text: In 2150, do the islands still have their light? Tell me the truth.
        expression: worried
      choices:
      - id: done
        label: Next!
        lines: []
        next: 
        effect: 
