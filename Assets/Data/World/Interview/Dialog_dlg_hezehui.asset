  m_Script: {fileID: 11500000, guid: 216f58e381e1445588efbd033278b8d9, type: 3}
  m_Name: Dialog_dlg_hezehui
  m_EditorClassIdentifier: Assembly-CSharp::DialogSO
  dialog:
    id: dlg_hezehui
    label: Ask about their work >
    oneShot: 1
    nodes:
    - id: start
      lines:
      - id: dlg_hezehui.start.1
        speaker: 1
        text: Uranium can split in three, or in four. I saw it. Nobody believed me
          at first.
        expression: neutral
      choices:
      - id: more1
        label: Go on.
        lines: []
        next: line2
        effect: 
      - id: bye1
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: line2
      lines:
      - id: dlg_hezehui.line2.1
        speaker: 1
        text: They call me the Chinese Marie Curie. I would rather they called me
          He Zehui.
        expression: happy
      choices:
      - id: more2
        label: Go on.
        lines: []
        next: line3
        effect: 
      - id: bye2
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: line3
      lines:
      - id: dlg_hezehui.line3.1
        speaker: 1
        text: Your hall hums. Is that a reactor? Who checks the shielding?
        expression: worried
      choices:
      - id: done
        label: Next!
        lines: []
        next: 
        effect: 
  conditions: []
