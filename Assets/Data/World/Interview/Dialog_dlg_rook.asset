      - id: dlg_rook.read.1
        speaker: 1
        text: Of course. And for a clerk who reads quickly, there's 50 cr in it.
          Between friends.
        expression: 
      choices:
      - id: take
        label: Take the 50 cr.
        lines:
        - id: dlg_rook.read.take.1
          speaker: 1
          text: Pleasure doing business.
          expression: 
        next: 
        effect: Effect_Dialog_BribeTaken
      - id: refuse
        label: Put that away.
        lines:
        - id: dlg_rook.read.refuse.1
          speaker: 1
          text: Suit yourself. It was a very quick 50.
