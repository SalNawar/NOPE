  m_Script: {fileID: 11500000, guid: 216f58e381e1445588efbd033278b8d9, type: 3}
  m_Name: Dialog_dlg_malaika
  m_EditorClassIdentifier: Assembly-CSharp::DialogSO
  dialog:
    id: dlg_malaika
    label: Ask about their work >
    oneShot: 1
    nodes:
    - id: start
      lines:
      - id: dlg_malaika.start.1
        speaker: 1
        text: I wrote a poem about cholera, and the old metre could not hold it.
          So I broke it.
        expression: neutral
      choices:
      - id: more1
        label: Go on.
        lines: []
        next: line2
        effect: 
      - id: bye1
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: line2
      lines:
      - id: dlg_malaika.line2.1
        speaker: 1
        text: The critics say a woman should not change Arabic verse. The verse did
          not ask them.
        expression: angry
      choices:
      - id: more2
        label: Go on.
        lines: []
        next: line3
        effect: 
      - id: bye2
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: line3
      lines:
      - id: dlg_malaika.line3.1
        speaker: 1
        text: Badr says he was first with free verse. We can argue in the queue.
        expression: happy
      choices:
      - id: done
        label: Next!
        lines: []
        next: 
        effect: 
  conditions: []
