  m_Script: {fileID: 11500000, guid: 216f58e381e1445588efbd033278b8d9, type: 3}
  m_Name: Dialog_dlg_tahtawi
  m_EditorClassIdentifier: Assembly-CSharp::DialogSO
  dialog:
    id: dlg_tahtawi
    label: Ask about their work >
    oneShot: 1
    nodes:
    - id: start
      lines:
      - id: dlg_tahtawi.start.1
        speaker: 1
        text: I went to Paris to lead the prayers. I came back with two thousand
          books.
        expression: happy
      choices:
      - id: more1
        label: Go on.
        lines: []
        next: line2
        effect: 
      - id: bye1
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: line2
      lines:
      - id: dlg_tahtawi.line2.1
        speaker: 1
        text: I translated the geography of the French. Now Cairo knows where Paris
          is.
        expression: neutral
      choices:
      - id: more2
        label: Go on.
        lines: []
        next: line3
        effect: 
      - id: bye2
        label: Safe travels.
        lines: []
        next: 
        effect: 
    - id: line3
      lines:
      - id: dlg_tahtawi.line3.1
        speaker: 1
        text: Your form asks my religion and my tailor. Ask what I can translate.
        expression: angry
      choices:
      - id: done
        label: Next!
        lines: []
        next: 
        effect: 
  conditions: []
