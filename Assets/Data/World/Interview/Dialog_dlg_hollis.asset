        effect: 
    - id: what
      lines:
      - id: dlg_hollis.what.1
        speaker: 1
        text: My father's waiver passed his debt to me when he didn't come back.
          The colliery was my way out.
        expression: 
      choices:
      - id: sorry
        label: I'm sorry.
        lines: []
        next: 
        effect: 
    - id: cant
      lines:
      - id: dlg_hollis.cant.1
        speaker: 1
        text: Nobody can. Stamp it quickly, then. Everyone else does.
