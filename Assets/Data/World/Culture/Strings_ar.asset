  - key: doc.waiver_no
    text: "\u0631\u0642\u0645 \u0627\u0644\u0625\u0642\u0631\u0627\u0631"
    gloss: 0
    tier: 0
  - key: doc.by_acknowledgment_of_this_instrument_the_traveller_accepts_a
    text: "\u0628\u0627\u0644\u0625\u0642\u0631\u0627\u0631 \u0628\u0647\u0630\u0647
      \u0627\u0644\u0648\u062B\u064A\u0642\u0629, \u064A\u0642\u0628\u0644 \u0627\u0644\u0645\u0633\u0627\u0641\u0631
      \u0643\u0644 \u0627\u0644\u0645\u062E\u0627\u0644\u0641\u0627\u062A \u0627\u0644\u0632\u0645\u0646\u064A\u0629
      \u0648\u0627\u0644\u0623\u0639\u0631\u0627\u0641 \u0627\u0644\u0645\u062D\u0644\u064A\u0629
      \u0648\u0627\u0644\u0625\u0632\u0627\u062D\u0629 \u0627\u0644\u0632\u0645\u0646\u064A\u0629
      \u0627\u0644\u0646\u0627\u062A\u062C\u0629 \u0639\u0646 \u0627\u0644\u0639\u0628\u0648\u0631
      \u0627\u0644\u0637\u0648\u0639\u064A \u0625\u0644\u0649 \u0645\u0627 \u0648\u0631\u0627\u0621
      \u0627\u0644\u062D\u0627\u0636\u0631 \u0627\u0644\u0645\u0635\u0631\u062D \u0628\u0647.
      \u0644\u0627 \u062A\u0636\u0645\u0646 \u0623\u064A \u0641\u062A\u0631\u0629
      \u0644\u0644\u0639\u0648\u062F\u0629."
    gloss: 0
    tier: 0
  - key: doc.the_traveller_assumes_responsibility_for_identity_drift_cale
    text: "\u064A\u062A\u062D\u0645\u0644 \u0627\u0644\u0645\u0633\u0627\u0641\u0631
      \u0645\u0633\u0624\u0648\u0644\u064A\u0629 \u0627\u0646\u062C\u0631\u0627\u0641
      \u0627\u0644\u0647\u0648\u064A\u0629 \u0648\u0627\u062E\u062A\u0644\u0627\u0641
      \u0627\u0644\u062A\u0642\u0648\u064A\u0645 \u0648\u0627\u0636\u0637\u0631\u0627\u0628
      \u0627\u0644\u0630\u0627\u0643\u0631\u0629 \u0648\u0643\u0644 \u0627\u0644\u0639\u0648\u0627\u0642\u0628
      \u0627\u0644\u0645\u0639\u062A\u0627\u062F\u0629 \u0644\u0644\u0628\u0642\u0627\u0621
      \u0641\u064A \u062D\u0642\u0628\u0629 \u0633\u0627\u0628\u0642\u0629. \u0644\u0627
      \u062A\u0648\u0642\u0641 \u0627\u0644\u0645\u0637\u0627\u0644\u0628\u0627\u062A
      \u0636\u062F \u0627\u0644\u0645\u0643\u062A\u0628 \u0627\u0644\u0642\u0631\u0646
      \u0627\u0644\u0645\u0639\u0645\u0648\u0644 \u0628\u0647."
    gloss: 0
    tier: 0
  - key: doc.acceptance_confirms_that_the_traveller_has_received_notice_o
    text: "\u064A\u0624\u0643\u062F \u0627\u0644\u0642\u0628\u0648\u0644 \u0623\u0646
      \u0627\u0644\u0645\u0633\u0627\u0641\u0631 \u062A\u0644\u0642\u0649 \u0625\u0634\u0639\u0627\u0631\u0627
      \u0628\u0634\u0631\u0648\u0637 \u0627\u0644\u0627\u0646\u0642\u0637\u0627\u0639
      \u0648\u064A\u0648\u0627\u0641\u0642 \u0639\u0644\u0649 \u0627\u0644\u0645\u0636\u064A
      \u062F\u0648\u0646 \u0627\u0646\u062A\u0638\u0627\u0631 \u0625\u0646\u0642\u0627\u0630
      \u0623\u0648 \u062A\u0635\u062D\u064A\u062D \u0623\u0648 \u0627\u0633\u062A\u0639\u0627\u062F\u0629.
      \u064A\u0628\u0642\u0649 \u0647\u0630\u0627 \u0627\u0644\u0625\u0642\u0631\u0627\u0631
      \u0633\u0627\u0631\u064A\u0627 \u0641\u064A \u0643\u0644 \u0627\u0644\u0627\u0633\u062A\u0645\u0631\u0627\u0631\u064A\u0627\u062A
      \u0627\u0644\u0645\u0639\u062A\u0631\u0641 \u0628\u0647\u0627."
    gloss: 0
    tier: 0
