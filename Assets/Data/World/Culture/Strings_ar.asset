    tier: 0
  - key: citation.rule.record
    text: "\u064A\u062C\u0628 \u0623\u0646 \u062A\u0637\u0627\u0628\u0642 \u0643\u0644
      \u0648\u0631\u0642\u0629 \u062D\u0633\u0627\u0628 \u0627\u0644\u0645\u0648\u0627\u0637\u0646."
    gloss: 0
    tier: 0
  - key: citation.rule.origin
    text: "\u0627\u0644\u0646\u0627\u0632\u062D\u0648\u0646 \u064A\u0639\u0648\u062F\u0648\u0646
      \u0625\u0644\u0649 \u0632\u0645\u0646\u0647\u0645 \u0641\u0642\u0637: \u064A\u062C\u0628
      \u0623\u0646 \u062A\u0637\u0627\u0628\u0642 \u0623\u0648\u0631\u0627\u0642\u0647\u0645
      \u0648\u0625\u062C\u0627\u0628\u0627\u062A\u0647\u0645 \u0623\u0635\u0644\u0647\u0645."
    gloss: 0
    tier: 0
  - key: citation.rule.goods
    text: "\u0644\u0627 \u0639\u0645\u0644\u0629 \u0648\u0644\u0627 \u062A\u0642\u0646\u064A\u0629
      \u0645\u0646 2150 \u062A\u063A\u0627\u062F\u0631 2150."
    gloss: 0
    tier: 0
  - key: citation.rule.dress
    text: "\u0627\u0644\u0644\u0628\u0627\u0633 \u0644\u0644\u0648\u062C\u0647\u0629:
      \u0644\u0627 \u0634\u064A\u0621 \u0645\u0646 \u0632\u0645\u0646 \u0622\u062E\u0631
      \u0623\u0648 \u0645\u0643\u0627\u0646 \u0622\u062E\u0631."
    gloss: 0
    tier: 0
  - key: citation.rule.paperSet.economyManifest
    text: "\u0627\u0644\u062C\u0648\u0627\u0632 \u0627\u0644\u0645\u0645\u062A\u0627\u0632
      \u064A\u0633\u0627\u0641\u0631 \u0628\u0645\u0631\u0633\u0627\u0644 \u0645\u0645\u062A\u0627\u0632."
    gloss: 0
    tier: 0
  - key: citation.rule.paperSet.premiumManifest
    text: "\u0627\u0644\u062C\u0648\u0627\u0632 \u0627\u0644\u0639\u0627\u062F\u064A
      \u064A\u0633\u0627\u0641\u0631 \u0628\u0645\u0631\u0633\u0627\u0644 \u0627\u0642\u062A\u0635\u0627\u062F\u064A."
    gloss: 0
    tier: 0
  - key: citation.rule.paperSet.waiverMissing
    text: "\u0647\u0630\u0647 \u0627\u0644\u0645\u063A\u0627\u062F\u0631\u0629 \u062A\u062A\u0637\u0644\u0628
      \u0625\u0642\u0631\u0627\u0631 \u0627\u0646\u0642\u0637\u0627\u0639 \u0645\u0648\u0642\u0639\u0627."
    gloss: 0
    tier: 0
  - key: citation.rule.paperSet.waiverUnsigned
    text: "\u0647\u0630\u0647 \u0627\u0644\u0645\u063A\u0627\u062F\u0631\u0629 \u062A\u062A\u0637\u0644\u0628
      \u0625\u0642\u0631\u0627\u0631 \u0627\u0646\u0642\u0637\u0627\u0639 \u0645\u0648\u0642\u0639\u0627."
    gloss: 0
    tier: 0
  - key: citation.rule.paperSet.proofMissing
    text: "\u0627\u0644\u062C\u0648\u0627\u0632 \u0627\u0644\u0639\u0627\u062F\u064A
      \u064A\u062A\u0637\u0644\u0628 \u0625\u062B\u0628\u0627\u062A \u0645\u0644\u0627\u0621\u0629."
    gloss: 0
    tier: 0
  - key: citation.rule.paperSet.contractMissing
    text: "\u0645\u063A\u0627\u062F\u0631\u0629 \u062A\u0633\u0648\u064A\u0629 \u0627\u0644\u062F\u064A\u0648\u0646
