    tier: 0
  - key: app.pins.full
    text: "\u0623\u0644\u063A \u062A\u062B\u0628\u064A\u062A \u0634\u064A\u0621 \u0623\u0648\u0644\u0627:
      \u0627\u0644\u062F\u0628\u0627\u0628\u064A\u0633 \u0645\u0645\u062A\u0644\u0626\u0629."
    gloss: 0
    tier: 0
  - key: app.pins.empty
    text: "Ctrl+P \u064A\u062B\u0628\u062A \u0627\u0644\u0642\u064A\u0645\u0629 \u0627\u0644\u062A\u064A
      \u0623\u0646\u062A \u0639\u0644\u064A\u0647\u0627. \u0627\u0646\u0642\u0631
      \u062F\u0628\u0648\u0633\u0627 \u0628\u0627\u0644\u0632\u0631 \u0627\u0644\u0623\u064A\u0645\u0646
      \u0644\u0625\u0644\u063A\u0627\u0621 \u062A\u062B\u0628\u064A\u062A\u0647."
    gloss: 0
    tier: 0
