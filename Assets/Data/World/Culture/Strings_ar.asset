    text: "\u0627\u0644\u062D\u0633\u0627\u0628 \u0627\u0644\u0645\u062C\u0645\u062F
      \u0644\u0627 \u064A\u063A\u0627\u062F\u0631."
    gloss: 0
    tier: 0
