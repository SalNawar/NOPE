  - key: settings.showShortcuts
    text: "\u0639\u0631\u0636 \u0627\u0644\u0627\u062E\u062A\u0635\u0627\u0631\u0627\u062A"
    gloss: 0
    tier: 0
  - key: keys.focusSearch
    text: "\u0627\u0641\u062A\u062D \u062F\u0631\u062C \u0627\u0644\u0628\u062D\u062B
      \u0641\u064A \u062A\u0637\u0628\u064A\u0642 \u0627\u0644\u062A\u062D\u0642\u064A\u0642"
    gloss: 0
    tier: 0
  - key: keys.intoResults
    text: "\u0645\u0646 \u062D\u0642\u0644 \u0627\u0644\u0628\u062D\u062B \u0625\u0644\u0649
      \u0646\u062A\u0627\u0626\u062C\u0647: \u0627\u0644\u0623\u0633\u0647\u0645
      \u062A\u062A\u0646\u0642\u0644 \u0628\u064A\u0646 \u0627\u0644\u0646\u062A\u0627\u0626\u062C,
      \u0648 Enter \u064A\u0641\u062A\u062D \u0625\u062D\u062F\u0627\u0647\u0627"
    gloss: 0
    tier: 0
  - key: keys.escape
    text: "\u0627\u0644\u0646\u0642\u0631 \u0627\u0644\u0623\u064A\u0645\u0646 \u0623\u0648
      Esc: \u0623\u063A\u0644\u0642 \u0642\u0627\u0626\u0645\u0629 \u0623\u0648 \u0647\u0630\u0647
      \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0623\u0648 \u062F\u0631\u062C
      \u0627\u0644\u0628\u062D\u062B, \u0627\u0645\u0633\u062D \u0627\u0644\u0628\u062D\u062B,
      \u0627\u062E\u0631\u062C \u0645\u0646 \u062D\u0642\u0644 \u0646\u0635, \u0623\u0641\u0644\u062A
      \u0642\u064A\u0645\u0629 \u0645\u0645\u0633\u0648\u0643\u0629, \u0623\u063A\u0644\u0642
      \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0623\u0648 \u0623\u0644\u063A
      \u0627\u0644\u0633\u062D\u0628. \u0648\u0625\u0646 \u0644\u0645 \u064A\u0643\u0646
      \u0634\u064A\u0621 \u0645\u0646 \u0630\u0644\u0643, \u0639\u062F \u0625\u0644\u0649
      \u0627\u0644\u0645\u0643\u062A\u0628"
    gloss: 0
    tier: 0
  - key: keys.help
    text: "\u0625\u0638\u0647\u0627\u0631 \u0647\u0630\u0647 \u0627\u0644\u0628\u0637\u0627\u0642\u0629
      \u0623\u0648 \u0625\u062E\u0641\u0627\u0624\u0647\u0627"
    gloss: 0
    tier: 0
  - key: keys.openIcon
    text: "\u0633\u0637\u062D \u0627\u0644\u0645\u0643\u062A\u0628: \u0627\u0641\u062A\u062D
      \u0627\u0644\u0623\u064A\u0642\u0648\u0646\u0629 \u0627\u0644\u0645\u062D\u062F\u062F\u0629"
    gloss: 0
    tier: 0
  - key: keys.icons
    text: "\u0633\u0637\u062D \u0627\u0644\u0645\u0643\u062A\u0628: \u062D\u062F\u062F
      \u0623\u0642\u0631\u0628 \u0623\u064A\u0642\u0648\u0646\u0629 \u0641\u064A
      \u0630\u0644\u0643 \u0627\u0644\u0627\u062A\u062C\u0627\u0647"
    gloss: 0
    tier: 0
  - key: keys.orders
    text: "\u0627\u0644\u0637\u0644\u0628\u0627\u062A: \u062A\u0646\u0642\u0644 \u0641\u064A
      \u0627\u0644\u0634\u062C\u0631\u0629 (\u0625\u0644\u0649 \u0645\u062A\u0637\u0644\u0628
      \u0633\u0627\u0628\u0642, \u0623\u0648 \u062A\u0627\u0628\u0639, \u0623\u0648
      \u0635\u0639\u0648\u062F\u0627 \u0648\u0646\u0632\u0648\u0644\u0627 \u0641\u064A
      \u0639\u0645\u0648\u062F)"
    gloss: 0
    tier: 0
  - key: keys.ordersAct
    text: "\u0627\u0644\u0637\u0644\u0628\u0627\u062A: \u0627\u0637\u0644\u0628 \u0627\u0644\u0639\u0646\u0635\u0631
      \u0627\u0644\u0645\u062D\u062F\u062F \u0623\u0648 \u0623\u0644\u063A\u0647
      \u0623\u0648 \u0631\u0643\u0628\u0647"
    gloss: 0
    tier: 0
  - key: keys.step
    text: "\u0627\u0644\u062A\u062D\u0642\u064A\u0642: \u0627\u0639\u0631\u0636 \u0648\u062B\u0627\u0626\u0642
      \u0627\u0644\u062E\u0637\u0648\u0627\u062A 1 \u0625\u0644\u0649 4 (\u0627\u0644\u0623\u0648\u0631\u0627\u0642,
      \u0627\u0644\u0633\u062C\u0644\u0627\u062A, \u0627\u0644\u0643\u062A\u0628,
      \u0627\u0644\u0642\u0648\u0627\u0639\u062F)"
    gloss: 0
    tier: 0
  - key: keys.nextStep
    text: "\u0627\u0644\u062A\u062D\u0642\u064A\u0642: \u0627\u0639\u0631\u0636 \u0648\u062B\u0627\u0626\u0642
      \u0627\u0644\u062E\u0637\u0648\u0629 \u0627\u0644\u062A\u0627\u0644\u064A\u0629
      \u0623\u0648 \u0627\u0644\u0633\u0627\u0628\u0642\u0629"
    gloss: 0
    tier: 0
  - key: keys.findings
    text: "\u0625\u0638\u0647\u0627\u0631 \u0639\u0645\u0648\u062F \u0627\u0644\u0646\u062A\u0627\u0626\u062C
      \u0623\u0648 \u0625\u062E\u0641\u0627\u0624\u0647"
    gloss: 0
    tier: 0
  - key: keys.otherPane
    text: "\u0627\u062C\u0639\u0644 \u0627\u0644\u062C\u0647\u0629 \u0627\u0644\u0623\u062E\u0631\u0649
      \u0647\u064A \u0627\u0644\u062A\u064A \u064A\u0641\u062A\u062D \u0641\u064A\u0647\u0627
      \u0627\u0644\u0631\u0641"
    gloss: 0
    tier: 0
  - key: keys.split
    text: "\u0644\u0648\u062D\u0627\u0646 \u0623\u0648 \u0644\u0648\u062D \u0648\u0627\u062D\u062F"
    gloss: 0
    tier: 0
  - key: keys.history
    text: "\u0631\u062C\u0648\u0639 \u0623\u0648 \u062A\u0642\u062F\u0645 \u0641\u064A
      \u0627\u0644\u0644\u0648\u062D \u0627\u0644\u0630\u064A \u064A\u0641\u062A\u062D
      \u0641\u064A\u0647 \u0627\u0644\u0631\u0641"
    gloss: 0
    tier: 0
  - key: keys.regions
    text: "\u0627\u0644\u062C\u0632\u0621 \u0627\u0644\u062A\u0627\u0644\u064A \u0623\u0648
      \u0627\u0644\u0633\u0627\u0628\u0642 \u0645\u0646 \u0627\u0644\u062A\u0637\u0628\u064A\u0642:
      \u0634\u0631\u064A\u0637 \u0627\u0644\u0642\u0648\u0627\u0626\u0645, \u0627\u0644\u0623\u0644\u0648\u0627\u062D,
      \u0627\u0644\u0646\u062A\u0627\u0626\u062C, \u0627\u0644\u0625\u0644\u063A\u0627\u0621"
    gloss: 0
    tier: 0
  - key: keys.rows
    text: "\u0627\u0646\u0642\u0644 \u0627\u0644\u062A\u0631\u0643\u064A\u0632 \u0628\u064A\u0646
      \u0627\u0644\u0642\u064A\u0645 \u0648\u0627\u0644\u0634\u0627\u0631\u0627\u062A
      \u0648\u0627\u0644\u0646\u062A\u0627\u0626\u062C \u0648\u0627\u0644\u062F\u0628\u0627\u0628\u064A\u0633
      \u0648\u0627\u0644\u0623\u0632\u0631\u0627\u0631"
    gloss: 0
    tier: 0
  - key: keys.follow
    text: "\u0627\u0641\u062A\u062D \u0627\u0644\u0639\u0646\u0635\u0631 \u0627\u0644\u0645\u062D\u062F\u062F,
      \u0623\u0648 \u0627\u062A\u0628\u0639 \u0631\u0627\u0628\u0637 \u0627\u0644\u0642\u064A\u0645\u0629"
    gloss: 0
    tier: 0
  - key: keys.followOther
    text: "\u0627\u062A\u0628\u0639 \u0631\u0627\u0628\u0637 \u0627\u0644\u0642\u064A\u0645\u0629,
      \u0623\u0648 \u0627\u0641\u062A\u062D \u0646\u062A\u064A\u062C\u0629 \u0627\u0644\u0628\u062D\u062B
      \u0627\u0644\u0645\u062D\u062F\u062F\u0629, \u0641\u064A \u0627\u0644\u062C\u0647\u0629
      \u0627\u0644\u0623\u062E\u0631\u0649"
    gloss: 0
    tier: 0
  - key: keys.pick
    text: "\u0627\u0645\u0633\u0643 \u0627\u0644\u0642\u064A\u0645\u0629 \u0627\u0644\u0645\u062D\u062F\u062F\u0629,
      \u062B\u0645 \u0642\u0627\u0631\u0646\u0647\u0627 \u0628\u0627\u0644\u062A\u0627\u0644\u064A\u0629"
    gloss: 0
    tier: 0
  - key: keys.copy
    text: "\u0627\u0646\u0633\u062E \u0627\u0644\u0642\u064A\u0645\u0629 \u0627\u0644\u0645\u062D\u062F\u062F\u0629,
      \u0623\u0648 \"\u0627\u0644\u062A\u0633\u0645\u064A\u0629: \u0627\u0644\u0642\u064A\u0645\u0629\""
    gloss: 0
    tier: 0
  - key: keys.paste
    text: "\u0627\u0644\u0645\u0644\u0627\u062D\u0638\u0627\u062A: \u0627\u0644\u0635\u0642
      \u0627\u0644\u0642\u064A\u0645\u0629 \u0627\u0644\u0645\u0646\u0633\u0648\u062E\u0629
      \u0643\u0642\u0635\u0627\u0635\u0629 (\u062D\u0642\u0644 \u0627\u0644\u0646\u0635
      \u064A\u0644\u0635\u0642 \u0643\u0627\u0644\u0645\u0639\u062A\u0627\u062F)"
    gloss: 0
    tier: 0
  - key: keys.pin
    text: "\u062B\u0628\u062A \u0627\u0644\u0642\u064A\u0645\u0629 \u0627\u0644\u0645\u062D\u062F\u062F\u0629
      \u0623\u0648 \u0623\u0644\u063A \u062A\u062B\u0628\u064A\u062A\u0647\u0627,
      \u0623\u0648 \u0648\u062B\u064A\u0642\u0629 \u0627\u0644\u0644\u0648\u062D"
    gloss: 0
    tier: 0
  - key: keys.zoom
    text: "\u0643\u0628\u0631 \u0627\u0644\u0623\u0644\u0648\u0627\u062D \u0623\u0648
      \u0635\u063A\u0631\u0647\u0627 \u0623\u0648 \u0623\u0639\u062F\u0647\u0627
      \u0625\u0644\u0649 \u062D\u062C\u0645 \u0627\u0644\u0646\u0635 \u0641\u064A
      \u0627\u0644\u0625\u0639\u062F\u0627\u062F\u0627\u062A (\u0634\u062C\u0631\u0629
      \u0627\u0644\u0637\u0644\u0628\u0627\u062A: \u062A\u0643\u0628\u064A\u0631,
      \u062A\u0635\u063A\u064A\u0631, \u0623\u0648 \u0627\u0644\u0639\u0648\u062F\u0629
      \u0625\u0644\u0649 100 %)"
    gloss: 0
    tier: 0
  - key: keys.contextMenu
    text: "\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0633\u064A\u0627\u0642 \u0644\u0644\u0635\u0641
      \u0627\u0644\u0645\u062D\u062F\u062F \u0623\u0648 \u0627\u0644\u0623\u064A\u0642\u0648\u0646\u0629
      \u0627\u0644\u0645\u062D\u062F\u062F\u0629 (\u0646\u0633\u062E, \u062A\u062B\u0628\u064A\u062A,
      \u0627\u062E\u062A\u064A\u0627\u0631, \u0641\u062A\u062D, \u062A\u0631\u062A\u064A\u0628)"
    gloss: 0
    tier: 0
  - key: keys.section.desk
    text: "\u0639\u0646\u062F \u0627\u0644\u0645\u0643\u062A\u0628"
    gloss: 0
    tier: 0
  - key: keys.section.pc
    text: "\u0639\u0644\u0649 \u0627\u0644\u062D\u0627\u0633\u0648\u0628"
    gloss: 0
    tier: 0
  - key: keys.desk.drag
    text: "\u062D\u0631\u0643 \u0648\u062B\u064A\u0642\u0629 \u0623\u0648 \u062E\u062A\u0645\u0627:
      \u0639\u0644\u0649 \u0627\u0644\u0637\u0627\u0648\u0644\u0629 \u062A\u0643\u0648\u0646
      \u0627\u0644\u0648\u062B\u064A\u0642\u0629 \u0635\u063A\u064A\u0631\u0629,
      \u0648\u0639\u0644\u0649 \u0627\u0644\u0645\u0643\u062A\u0628 \u0628\u062D\u062C\u0645\u0647\u0627
      \u0627\u0644\u0643\u0627\u0645\u0644. \u0628\u0639\u062F \u062E\u062A\u0645
      \u0627\u0644\u062C\u0648\u0627\u0632, \u0648\u0631\u0642\u0629 \u062A\u0633\u0642\u0637\u0647\u0627
      \u0639\u0644\u0649 \u0627\u0644\u0637\u0627\u0648\u0644\u0629 \u062A\u0639\u064A\u062F
      \u0627\u0644\u0623\u0648\u0631\u0627\u0642"
    gloss: 0
    tier: 0
  - key: keys.desk.inspect
    text: "\u0648\u0636\u0639 \u0627\u0644\u0641\u062D\u0635 (\u0627\u0644\u0632\u0631
      \u0627\u0644\u0623\u062D\u0645\u0631): \u0627\u0646\u0642\u0631 \u0634\u064A\u0626\u064A\u0646
      \u0644\u0645\u0642\u0627\u0631\u0646\u062A\u0647\u0645\u0627"
    gloss: 0
    tier: 0
  - key: keys.desk.stamps
    text: "\u0634\u0631\u064A\u0637 \u0627\u0644\u0623\u062E\u062A\u0627\u0645 (\u0627\u0644\u0644\u0633\u0627\u0646
      \u0627\u0644\u0631\u0645\u0627\u062F\u064A \u0639\u0644\u0649 \u0627\u0644\u064A\u0645\u064A\u0646):
      \u0627\u0633\u062D\u0628 \u062E\u062A\u0645\u0627 \u0625\u0644\u0649 \u0627\u0644\u062C\u0648\u0627\u0632
      \u0648\u0623\u0641\u0644\u062A\u0647"
    gloss: 0
    tier: 0
  - key: keys.desk.pc
    text: "\u0625\u0644\u0649 \u0627\u0644\u062D\u0627\u0633\u0648\u0628 \u0648\u0627\u0644\u0639\u0648\u062F\u0629
      (\u0627\u0644\u0644\u0633\u0627\u0646 \u0627\u0644\u0631\u0645\u0627\u062F\u064A
      \u0639\u0644\u0649 \u0627\u0644\u064A\u0633\u0627\u0631)"
    gloss: 0
    tier: 0
  - key: keys.desk.back
    text: "\u062A\u0631\u0627\u062C\u0639: \u0627\u0644\u0633\u062D\u0628, \u0627\u0644\u0639\u062C\u0644\u0629,
      \u0627\u0644\u062D\u0627\u0633\u0648\u0628, \u0627\u0644\u0642\u064A\u0645\u0629
      \u0627\u0644\u0645\u0645\u0633\u0648\u0643\u0629, \u0648\u0636\u0639 \u0627\u0644\u0641\u062D\u0635,
      \u0634\u0631\u064A\u0637 \u0627\u0644\u0623\u062E\u062A\u0627\u0645, \u0627\u0644\u0645\u062F\u064A\u0646\u0629,
      \u0639\u0631\u0636 \u0627\u0644\u0642\u0631\u0627\u0621\u0629"
    gloss: 0
    tier: 0
  - key: keys.desk.city
    text: "\u0627\u0646\u0638\u0631 \u0625\u0644\u0649 \u0627\u0644\u0645\u062F\u064A\u0646\u0629,
      \u062B\u0645 \u0639\u062F"
    gloss: 0
    tier: 0
