  - key: citation.unproven
    text: "\u0631\u0641\u0636 \u0628\u0644\u0627 \u062F\u0644\u064A\u0644 \u0645\u0633\u062C\u0644.
      \u0633\u062C\u0644 \u0627\u0644\u062E\u0637\u0623 \u0642\u0628\u0644 \u0627\u0644\u0631\u0641\u0636:
      \u0641\u0631\u0642 \u0641\u064A \u0627\u0644\u0623\u0648\u0631\u0627\u0642,
      \u0623\u0648 \u0642\u0627\u0639\u062F\u0629 \u064A\u062E\u0627\u0644\u0641\u0647\u0627,
      \u0623\u0648 \u062A\u0627\u0631\u064A\u062E \u0644\u0627 \u064A\u0635\u0644\u062D."
    gloss: 0
    tier: 0
  - key: citation.acceptedWrong
    text: "\u0648\u0627\u0641\u0642\u062A \u0639\u0644\u0649 \u0645\u0633\u0627\u0641\u0631
      \u0645\u062A\u0646\u0643\u0631 \u0623\u0648 \u0648\u062C\u0647\u0629 \u0645\u062D\u0638\u0648\u0631\u0629."
    gloss: 0
    tier: 0
  - key: citation.acceptedWrong.panic
    text: "\u0648\u0627\u0641\u0642\u062A \u0639\u0644\u0649 \u0645\u0633\u0627\u0641\u0631
      \u0633\u064A\u062B\u064A\u0631 \u0627\u0644\u0630\u0639\u0631 \u0641\u064A
      {0}."
    gloss: 0
    tier: 0
  - key: citation.acceptedWrong.forged
    text: "\u0648\u0627\u0641\u0642\u062A \u0639\u0644\u0649 \u0623\u0648\u0631\u0627\u0642
      \u0645\u0632\u0648\u0631\u0629."
    gloss: 0
    tier: 0
  - key: citation.acceptedWrong.disguised
    text: "\u0648\u0627\u0641\u0642\u062A \u0639\u0644\u0649 \u0645\u0633\u0627\u0641\u0631
