  - key: desktop.arrange
    text: "\u062A\u0631\u062A\u064A\u0628 \u0627\u0644\u0623\u064A\u0642\u0648\u0646\u0627\u062A"
    gloss: 0
    tier: 0
  - key: menu.open
    text: "\u0641\u062A\u062D"
    gloss: 0
    tier: 0
  - key: settings.note
    text: "\u0627\u0644\u0623\u0644\u0648\u0627\u0646 \u0648\u0627\u0644\u062E\u0637\u0648\u0637
      \u0648\u0627\u0644\u062E\u0644\u0641\u064A\u0629 \u062A\u062A\u0628\u0639 \u0627\u0644\u062A\u0627\u0631\u064A\u062E
      \u062F\u0627\u0626\u0645\u0627. \u062A\u063A\u064A\u064A\u0631 \u0627\u0644\u0644\u063A\u0629
      \u064A\u0633\u0631\u064A \u0641\u064A \u0627\u0644\u0645\u0631\u0629 \u0627\u0644\u0642\u0627\u062F\u0645\u0629
      \u0627\u0644\u062A\u064A \u064A\u0641\u062A\u062D \u0641\u064A\u0647\u0627
      \u0627\u0644\u0645\u0643\u062A\u0628. \u0627\u0644\u062D\u0631\u0643\u0629
      \u0627\u0644\u0645\u062E\u0641\u0641\u0629 \u062A\u0639\u0631\u0636 \u0627\u0644\u062A\u0631\u062C\u0645\u0627\u062A
      \u0641\u0648\u0631\u0627."
    gloss: 0
    tier: 0
