    gloss: 0
    tier: 0
  - key: citation.detainedUnproven
    text: "\u0627\u062D\u062A\u062C\u0627\u0632 \u0628\u0644\u0627 \u062F\u0644\u064A\u0644
      \u0645\u0633\u062C\u0644. \u0633\u062C\u0644 \u0645\u0627 \u062E\u0627\u0644\u0641\u0647
      \u0642\u0628\u0644 \u0627\u0644\u0627\u062D\u062A\u062C\u0627\u0632: \u0648\u0631\u0642\u0629
      \u0645\u0632\u0648\u0631\u0629, \u0623\u0648 \u0647\u0648\u064A\u0629 \u0643\u0627\u0630\u0628\u0629,
      \u0623\u0648 \u0628\u0636\u0627\u0639\u0629 \u0645\u0647\u0631\u0628\u0629."
    gloss: 0
    tier: 0
