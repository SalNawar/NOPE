    gloss: 0
    tier: 0
  - key: keys.desk.back
    text: "\u0388\u03BE\u03BF\u03B4\u03BF\u03C2: \u03B1\u03C0\u03CC \u03C3\u03CD\u03C1\u03C3\u03B9\u03BC\u03BF,
      \u03C4\u03C1\u03BF\u03C7\u03CC, \u03C5\u03C0\u03BF\u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03AE,
      \u03C4\u03B9\u03BC\u03AE \u03C0\u03BF\u03C5 \u03BA\u03C1\u03B1\u03C4\u03AC\u03C2,
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03B5\u03C0\u03B9\u03B8\u03B5\u03CE\u03C1\u03B7\u03C3\u03B7\u03C2,
      \u03BC\u03C0\u03AC\u03C1\u03B1 \u03BC\u03B5 \u03C3\u03C4\u03AC\u03BC\u03C0\u03B5\u03C2,
      \u03C0\u03CC\u03BB\u03B7, \u03C0\u03C1\u03BF\u03B2\u03BF\u03BB\u03AE \u03B1\u03BD\u03AC\u03B3\u03BD\u03C9\u03C3\u03B7\u03C2"
