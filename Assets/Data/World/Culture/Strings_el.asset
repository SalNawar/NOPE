    tier: 0
  - key: citation.rule.record
    text: "\u039A\u03AC\u03B8\u03B5 \u03AD\u03B3\u03B3\u03C1\u03B1\u03C6\u03BF \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03BD\u03B1 \u03C4\u03B1\u03B9\u03C1\u03B9\u03AC\u03B6\u03B5\u03B9 \u03BC\u03B5
      \u03C4\u03BF\u03BD \u039B\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7."
    gloss: 0
    tier: 0
  - key: citation.rule.origin
    text: "\u039F\u03B9 \u03B5\u03BA\u03C4\u03BF\u03C0\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03B5\u03C0\u03B9\u03C3\u03C4\u03C1\u03AD\u03C6\u03BF\u03C5\u03BD \u03BC\u03CC\u03BD\u03BF
      \u03C3\u03C4\u03B7 \u03B4\u03B9\u03BA\u03AE \u03C4\u03BF\u03C5\u03C2 \u03B5\u03C0\u03BF\u03C7\u03AE:
      \u03C4\u03B1 \u03AD\u03B3\u03B3\u03C1\u03B1\u03C6\u03B1 \u03BA\u03B1\u03B9
      \u03BF\u03B9 \u03B1\u03C0\u03B1\u03BD\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2 \u03C4\u03BF\u03C5\u03C2
      \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03C4\u03B1\u03B9\u03C1\u03B9\u03AC\u03B6\u03BF\u03C5\u03BD
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03AD\u03BB\u03B5\u03C5\u03C3\u03AE
      \u03C4\u03BF\u03C5\u03C2."
    gloss: 0
    tier: 0
  - key: citation.rule.goods
    text: "\u039A\u03B1\u03BD\u03AD\u03BD\u03B1 \u03BD\u03CC\u03BC\u03B9\u03C3\u03BC\u03B1
      \u03AE \u03C4\u03B5\u03C7\u03BD\u03BF\u03BB\u03BF\u03B3\u03AF\u03B1 \u03C4\u03BF\u03C5
      2150 \u03B4\u03B5\u03BD \u03C6\u03B5\u03CD\u03B3\u03B5\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03BF 2150."
    gloss: 0
    tier: 0
  - key: citation.rule.dress
    text: "\u0388\u03BD\u03B4\u03C5\u03C3\u03B7 \u03B3\u03B9\u03B1 \u03C4\u03BF\u03BD
      \u03C0\u03C1\u03BF\u03BF\u03C1\u03B9\u03C3\u03BC\u03CC: \u03C4\u03AF\u03C0\u03BF\u03C4\u03B1
      \u03B1\u03C0\u03CC \u03AC\u03BB\u03BB\u03B7 \u03B5\u03C0\u03BF\u03C7\u03AE
      \u03AE \u03AC\u03BB\u03BB\u03BF\u03BD \u03C4\u03CC\u03C0\u03BF."
    gloss: 0
    tier: 0
  - key: citation.rule.paperSet.economyManifest
    text: "\u0388\u03BD\u03B1 \u03B4\u03B9\u03B1\u03B2\u03B1\u03C4\u03AE\u03C1\u03B9\u03BF
      Premium \u03C4\u03B1\u03BE\u03B9\u03B4\u03B5\u03CD\u03B5\u03B9 \u03BC\u03B5
      \u03B1\u03BD\u03B1\u03BC\u03B5\u03C4\u03B1\u03B4\u03CC\u03C4\u03B7 Premium."
    gloss: 0
    tier: 0
  - key: citation.rule.paperSet.premiumManifest
    text: "\u0388\u03BD\u03B1 \u039A\u03B1\u03BD\u03BF\u03BD\u03B9\u03BA\u03CC \u03B4\u03B9\u03B1\u03B2\u03B1\u03C4\u03AE\u03C1\u03B9\u03BF
      \u03C4\u03B1\u03BE\u03B9\u03B4\u03B5\u03CD\u03B5\u03B9 \u03BC\u03B5 \u03B1\u03BD\u03B1\u03BC\u03B5\u03C4\u03B1\u03B4\u03CC\u03C4\u03B7
      Economy."
    gloss: 0
    tier: 0
  - key: citation.rule.paperSet.waiverMissing
    text: "\u0391\u03C5\u03C4\u03AE \u03B7 \u03B1\u03BD\u03B1\u03C7\u03CE\u03C1\u03B7\u03C3\u03B7
      \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03C5\u03C0\u03BF\u03B3\u03B5\u03B3\u03C1\u03B1\u03BC\u03BC\u03AD\u03BD\u03B7
      \u0394\u03AE\u03BB\u03C9\u03C3\u03B7 \u03C0\u03B1\u03C1\u03B1\u03AF\u03C4\u03B7\u03C3\u03B7\u03C2
      \u03B5\u03B3\u03BA\u03BB\u03C9\u03B2\u03B9\u03C3\u03BC\u03BF\u03CD."
    gloss: 0
    tier: 0
  - key: citation.rule.paperSet.waiverUnsigned
    text: "\u0391\u03C5\u03C4\u03AE \u03B7 \u03B1\u03BD\u03B1\u03C7\u03CE\u03C1\u03B7\u03C3\u03B7
      \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03C5\u03C0\u03BF\u03B3\u03B5\u03B3\u03C1\u03B1\u03BC\u03BC\u03AD\u03BD\u03B7
      \u0394\u03AE\u03BB\u03C9\u03C3\u03B7 \u03C0\u03B1\u03C1\u03B1\u03AF\u03C4\u03B7\u03C3\u03B7\u03C2
