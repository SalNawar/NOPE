      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B1\u03BD\u03B1\u03C7\u03C9\u03C1\u03AE\u03C3\u03B5\u03B9."
    gloss: 0
    tier: 0
  - key: citation.rule.departure
    text: "\u0391\u03BD\u03B1\u03C7\u03CE\u03C1\u03B7\u03C3\u03B7 \u03BC\u03CC\u03BD\u03BF
