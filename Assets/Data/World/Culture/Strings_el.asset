  - key: citation.unproven
    text: "\u0391\u03C0\u03CC\u03C1\u03C1\u03B9\u03C8\u03B7 \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03B5\u03B3\u03C1\u03B1\u03BC\u03BC\u03AD\u03BD\u03BF
      \u03B1\u03C0\u03BF\u03B4\u03B5\u03B9\u03BA\u03C4\u03B9\u03BA\u03CC. \u039A\u03B1\u03C4\u03AC\u03B3\u03C1\u03B1\u03C8\u03B5
      \u03C4\u03B9 \u03B4\u03B5\u03BD \u03C0\u03AC\u03B5\u03B9 \u03BA\u03B1\u03BB\u03AC
      \u03C0\u03C1\u03B9\u03BD \u03B1\u03C0\u03BF\u03C1\u03C1\u03AF\u03C8\u03B5\u03B9\u03C2:
      \u03BC\u03B9\u03B1 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC \u03C3\u03C4\u03B1
      \u03AD\u03B3\u03B3\u03C1\u03B1\u03C6\u03B1, \u03AD\u03BD\u03B1\u03BD \u03BA\u03B1\u03BD\u03CC\u03BD\u03B1
      \u03C0\u03BF\u03C5 \u03C0\u03B1\u03C1\u03B1\u03B2\u03B9\u03AC\u03B6\u03BF\u03C5\u03BD
      \u03AE \u03BC\u03B9\u03B1 \u03B7\u03BC\u03B5\u03C1\u03BF\u03BC\u03B7\u03BD\u03AF\u03B1
      \u03C0\u03BF\u03C5 \u03B4\u03B5\u03BD \u03B9\u03C3\u03C7\u03CD\u03B5\u03B9."
    gloss: 0
    tier: 0
  - key: citation.acceptedWrong
    text: "\u0395\u03BD\u03AD\u03BA\u03C1\u03B9\u03BD\u03B5\u03C2 \u03BC\u03B5\u03C4\u03B1\u03BC\u03C6\u03B9\u03B5\u03C3\u03BC\u03AD\u03BD\u03BF
