    gloss: 0
    tier: 0
  - key: citation.rule.paperSet.contractMissing
    text: "\u039C\u03B9\u03B1 \u03B1\u03BD\u03B1\u03C7\u03CE\u03C1\u03B7\u03C3\u03B7
