  - key: keys.zoom
    text: "\u039C\u03B5\u03B3\u03AD\u03B8\u03C5\u03BD\u03C3\u03B7, \u03C3\u03BC\u03AF\u03BA\u03C1\u03C5\u03BD\u03C3\u03B7
