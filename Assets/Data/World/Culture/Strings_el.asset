  - key: keys.intoResults
    text: "\u0391\u03C0\u03CC \u03C4\u03BF \u03C0\u03B5\u03B4\u03AF\u03BF \u03B1\u03BD\u03B1\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7\u03C2
      \u03C3\u03C4\u03B1 \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03AD\u03C3\u03BC\u03B1\u03C4\u03B1:
      \u03C4\u03B1 \u03B2\u03AD\u03BB\u03B7 \u03C0\u03B5\u03C1\u03BD\u03BF\u03CD\u03BD
      \u03B1\u03C0\u03CC \u03C4\u03B1 \u03B5\u03C5\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1,
      \u03C4\u03BF Enter \u03B1\u03BD\u03BF\u03AF\u03B3\u03B5\u03B9 \u03AD\u03BD\u03B1"
    gloss: 0
    tier: 0
  - key: keys.escape
    text: "\u0394\u03B5\u03BE\u03AF \u03BA\u03BB\u03B9\u03BA \u03AE Esc: \u03BA\u03BB\u03B5\u03AF\u03BD\u03B5\u03B9
      \u03AD\u03BD\u03B1 \u03BC\u03B5\u03BD\u03BF\u03CD, \u03B1\u03C5\u03C4\u03AE
      \u03C4\u03B7\u03BD \u03BA\u03AC\u03C1\u03C4\u03B1 \u03AE \u03C4\u03B7\u03BD
      \u03B1\u03BD\u03B1\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7\xB7 \u03BA\u03B1\u03B8\u03B1\u03C1\u03AF\u03B6\u03B5\u03B9
      \u03C4\u03B7\u03BD \u03B1\u03BD\u03B1\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7\xB7
      \u03B2\u03B3\u03B1\u03AF\u03BD\u03B5\u03B9 \u03B1\u03C0\u03CC \u03C0\u03B5\u03B4\u03AF\u03BF
      \u03BA\u03B5\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5\xB7 \u03B1\u03C6\u03AE\u03BD\u03B5\u03B9
      \u03BC\u03B9\u03B1 \u03C4\u03B9\u03BC\u03AE \u03C0\u03BF\u03C5 \u03BA\u03C1\u03B1\u03C4\u03AC\u03C2\xB7
      \u03BA\u03BB\u03B5\u03AF\u03BD\u03B5\u03B9 \u03C4\u03BF \u039C\u03B5\u03BD\u03BF\u03CD
      \u03AE \u03B1\u03BA\u03C5\u03C1\u03CE\u03BD\u03B5\u03B9 \u03AD\u03BD\u03B1
      \u03C3\u03CD\u03C1\u03C3\u03B9\u03BC\u03BF. \u0391\u03BD \u03B4\u03B5\u03BD
      \u03B9\u03C3\u03C7\u03CD\u03B5\u03B9 \u03C4\u03AF\u03C0\u03BF\u03C4\u03B1 \u03B1\u03C0\u03CC
      \u03B1\u03C5\u03C4\u03AC, \u03C0\u03AF\u03C3\u03C9 \u03C3\u03C4\u03BF \u03B3\u03C1\u03B1\u03C6\u03B5\u03AF\u03BF"
    gloss: 0
    tier: 0
