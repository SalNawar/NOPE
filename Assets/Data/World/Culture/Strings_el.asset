      \u03C0\u03BB\u03B1\u03B9\u03C3\u03AF\u03C9\u03BD \u03C3\u03C4\u03BF \u039C\u03AD\u03B3\u03B5\u03B8\u03BF\u03C2
      \u03BA\u03B5\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5 \u03C4\u03C9\u03BD \u03A1\u03C5\u03B8\u03BC\u03AF\u03C3\u03B5\u03C9\u03BD
      (\u03C3\u03C4\u03BF \u03B4\u03AD\u03BD\u03C4\u03C1\u03BF \u03A0\u03B1\u03C1\u03B1\u03B3\u03B3\u03B5\u03BB\u03B9\u03CE\u03BD:
      \u03BC\u03B5\u03B3\u03AD\u03B8\u03C5\u03BD\u03C3\u03B7, \u03C3\u03BC\u03AF\u03BA\u03C1\u03C5\u03BD\u03C3\u03B7
      \u03AE 100 %)"
    gloss: 0
