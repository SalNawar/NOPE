    text: "\u03A3\u03C4\u03BF\u03BD \u03C5\u03C0\u03BF\u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03AE"
    gloss: 0
    tier: 0
  - key: keys.desk.drag
    text: "\u039C\u03B5\u03C4\u03B1\u03BA\u03AF\u03BD\u03B7\u03C3\u03B7 \u03B5\u03B3\u03B3\u03C1\u03AC\u03C6\u03BF\u03C5
      \u03AE \u03C3\u03C4\u03AC\u03BC\u03C0\u03B1\u03C2: \u03C3\u03C4\u03BF\u03BD
      \u03C0\u03AC\u03B3\u03BA\u03BF \u03AD\u03BD\u03B1 \u03AD\u03B3\u03B3\u03C1\u03B1\u03C6\u03BF
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03B9\u03BA\u03C1\u03CC, \u03C3\u03C4\u03BF
      \u03B3\u03C1\u03B1\u03C6\u03B5\u03AF\u03BF \u03C3\u03B5 \u03C0\u03BB\u03AE\u03C1\u03B5\u03C2
      \u03BC\u03AD\u03B3\u03B5\u03B8\u03BF\u03C2\xB7 \u03CC\u03C4\u03B1\u03BD \u03C4\u03BF
      \u03B4\u03B9\u03B1\u03B2\u03B1\u03C4\u03AE\u03C1\u03B9\u03BF \u03AD\u03C7\u03B5\u03B9
      \u03C3\u03C6\u03C1\u03B1\u03B3\u03B9\u03C3\u03C4\u03B5\u03AF, \u03AD\u03BD\u03B1
      \u03AD\u03B3\u03B3\u03C1\u03B1\u03C6\u03BF \u03C0\u03BF\u03C5 \u03B1\u03C6\u03AE\u03BD\u03B5\u03B9\u03C2
      \u03C3\u03C4\u03BF\u03BD \u03C0\u03AC\u03B3\u03BA\u03BF \u03B5\u03C0\u03B9\u03C3\u03C4\u03C1\u03AD\u03C6\u03B5\u03B9
      \u03C4\u03B1 \u03AD\u03B3\u03B3\u03C1\u03B1\u03C6\u03B1"
    gloss: 0
    tier: 0
  - key: keys.desk.inspect
    text: "\u039B\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03B5\u03C0\u03B9\u03B8\u03B5\u03CE\u03C1\u03B7\u03C3\u03B7\u03C2
      (\u03C4\u03BF \u03BA\u03CC\u03BA\u03BA\u03B9\u03BD\u03BF \u03BA\u03BF\u03C5\u03BC\u03C0\u03AF):
