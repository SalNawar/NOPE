    tier: 0
  - key: citation.rule.paperSet.proofMissing
    text: "\u0388\u03BD\u03B1 \u039A\u03B1\u03BD\u03BF\u03BD\u03B9\u03BA\u03CC \u03B4\u03B9\u03B1\u03B2\u03B1\u03C4\u03AE\u03C1\u03B9\u03BF
